# ===== WhatsApp Cloud API (Meta) =====
WHATSAPP_TOKEN=tu_token_permanente_de_meta
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id
WHATSAPP_VERIFY_TOKEN=elegi_una_palabra_secreta_para_verificar_el_webhook
WHATSAPP_BUSINESS_ACCOUNT_ID=tu_waba_id

# ===== Claude (Anthropic) =====
ANTHROPIC_API_KEY=sk-ant-tu-api-key

# ===== Google Calendar =====
# Credenciales de una cuenta de servicio de Google Cloud con acceso al calendario
GOOGLE_SERVICE_ACCOUNT_EMAIL=nombre@proyecto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_CLAVE\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=tu_email_de_calendario@gmail.com

# ===== Negocio =====
BUSINESS_NAME=Tu Gestoría
TIMEZONE=America/Argentina/Buenos_Aires
SLOT_MINUTES=30
# Horarios de atención (formato 24h)
HOURS_MON_FRI_START=10:00
HOURS_MON_FRI_END=18:00
HOURS_SAT_START=10:00
HOURS_SAT_END=14:00

# ===== Servidor =====
PORT=3000
ADMIN_PASSWORD=elegi_una_clave_para_entrar_al_panel_crm

# ===== Recordatorios / recuperación =====
# Horas sin respuesta del cliente antes de mandar un mensaje de recupero
RECOVERY_HOURS=6
# Horas antes del turno para mandar el recordatorio
REMINDER_HOURS_BEFORE=24
REMINDER_HOURS_BEFORE_SHORT=2
